{
  "name": "@ishk9/yoyo",
  "version": "0.2.0",
  "description": "Freeze the page you're working on, keep editing, flip back to compare.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ishk9/yoyo.git",
    "directory": "packages/yoyo"
  },
  "keywords": [
    "nextjs",
    "vite",
    "hmr",
    "visual-diff",
    "devtools"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "CHANGELOG.md"
  ],
  "sideEffects": true,
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "prepublishOnly": "cp ../../README.md ../../LICENSE ../../CHANGELOG.md . && pnpm build && pnpm test"
  },
  "devDependencies": {
    "jsdom": "^30",
    "tsup": "^8",
    "typescript": "^5",
    "vitest": "^5"
  },
  "publishConfig": {
    "access": "public"
  }
}
